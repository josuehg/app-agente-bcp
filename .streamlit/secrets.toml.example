# Copia este archivo como .streamlit/secrets.toml y rellena tus datos
# reales. NUNCA subas secrets.toml (el real) a GitHub — por eso esta
# en el .gitignore. Cuando despliegues en Streamlit Community Cloud,
# estos mismos valores se pegan en la seccion "Secrets" del panel web,
# no en un archivo.

spreadsheet_id = "PEGA_AQUI_EL_ID_DE_TU_GOOGLE_SHEET"
drive_folder_id = "PEGA_AQUI_EL_ID_DE_LA_CARPETA_DE_DRIVE"
dashboard_pin = "1234"

# Aviso por Telegram de las solicitudes de efectivo/saldo (opcional). En
# Railway es mas simple crear dos VARIABLES con estos nombres exactos, en
# vez de tocar este bloque: TELEGRAM_BOT_TOKEN y TELEGRAM_CHAT_ID.
# (Si los pones aqui, deben ir ARRIBA de la seccion [gcp_service_account].)
# telegram_token = "123456:ABC..."   # lo da @BotFather al crear el bot
# telegram_chat_id = "123456789"     # tu chat (o el de un grupo con el bot)
# Desde cuantos soles de diferencia (en un Cierre o entre Cierre y Apertura) se avisa por Telegram.
# Por defecto 6; en Railway se cambia con la variable ALERTA_DIFERENCIA_SOLES.
# alerta_diferencia_soles = 6

[gcp_service_account]
type = "service_account"
project_id = "tu-proyecto"
private_key_id = "xxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nxxxx\n-----END PRIVATE KEY-----\n"
client_email = "tu-cuenta-de-servicio@tu-proyecto.iam.gserviceaccount.com"
client_id = "xxxx"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/tu-cuenta-de-servicio%40tu-proyecto.iam.gserviceaccount.com"
